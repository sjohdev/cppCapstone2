    template<typename t>
    CImgList<t>& move_to(CImgList<t>& list, const unsigned int pos) {
      if (is_empty()) return list;
      const unsigned int npos = pos>list._width?list._width:pos;
      list.insert(_width,npos);
      for (int l = 0; l<(int)(*this)._width; ++l) if (_data[l]._is_shared) { list[npos + l].assign(_data[l]); _data[l].assign(); }
      for (int l = 0; l<(int)(*this)._width; ++l) if (_data[l]) _data[l].move_to(list[npos + l]);
      assign();
      return list;
    }






