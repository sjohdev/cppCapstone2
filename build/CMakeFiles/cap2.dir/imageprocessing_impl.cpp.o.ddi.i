              if (imgout._data==imglist[l]._data && imgout.is_sameXYZC(imglist[l])) { pos = l; break; }
            if (pos!=~0U) mem_img_index = const_scalar((double)pos);
          }
        }
        return mem_img_index;
      }


      void get_variable_pos(const char *variable_name, unsigned int &pos, unsigned int &rpos) {
        char c1, c2, c3, c4;
        pos = rpos = ~0U;
        if (!variable_name || !*variable_name) return;

        unsigned int rp = variable_name[1]?~0U:*variable_name;
        if (variable_name[1] && !variable_name[2]) {
          c1 = variable_name[0];
          c2 = variable_name[1];
          if (c1=='w' && c2=='h') rp = 0;
          else if (c1=='p' && c2=='i') rp = 3;
          else if (c1=='_' && c2=='0') rp = 34;
          else if (c1=='_' && c2=='1') rp = 35;
          else if (c1=='i') {
            if (c2>='0' && c2<='9') rp = 21 + c2 - '0';
            else if (c2=='m') rp = 4;
            else if (c2=='M') rp = 5;
            else if (c2=='a') rp = 6;
            else if (c2=='v') rp = 7;
            else if (c2=='d') rp = 8;
            else if (c2=='s') rp = 9;
            else if (c2=='p') rp = 10;
            else if (c2=='c') rp = 11;
            else if (c2=='n') rp = 12;
          } else if (c2=='m') {
            if (c1=='x') rp = 13;
            else if (c1=='y') rp = 14;
            else if (c1=='z') rp = 15;
            else if (c1=='c') rp = 16;
          } else if (c2=='M') {
            if (c1=='x') rp = 17;
            else if (c1=='y') rp = 18;
            else if (c1=='z') rp = 19;
            else if (c1=='c') rp = 20;
          }
        } else if (variable_name[1] && variable_name[2] && !variable_name[3]) {
          c1 = variable_name[0];
          c2 = variable_name[1];
          c3 = variable_name[2];
          if (c1=='w' && c2=='h' && c3=='d') rp = 1;
          else if (c1=='e' && c2=='p' && c3=='s') rp = 33;
        } else if (variable_name[1] && variable_name[2] && variable_name[3] &&
                   !variable_name[4]) {
          c1 = variable_name[0];
          c2 = variable_name[1];
          c3 = variable_name[2];
          c4 = variable_name[3];
          if (c1=='w' && c2=='h' && c3=='d' && c4=='s') rp = 2;
        } else if (!std::strcmp(variable_name,"interpolation")) rp = 31;
        else if (!std::strcmp(variable_name,"boundary")) rp = 32;

        if (rp!=~0U) { rpos = rp; return; }


        for (int i = (int)(variable_def)._width - 1; i>=0; --i)
          if (!std::strcmp(variable_name,variable_def[i])) { pos = i; break; }
      }


