      static double mp_cut(_cimg_math_parser& mp) {
        double val = mp.mem[mp.opcode[2]], cmin = mp.mem[mp.opcode[3]], cmax = mp.mem[mp.opcode[4]];
        return cimg::cut(val,cmin,cmax);
