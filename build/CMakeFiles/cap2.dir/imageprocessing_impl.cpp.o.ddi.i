          mem[31] = imgin._width - 1.;
          mem[32] = imgin._height - 1.;
          mem[33] = imgin._depth - 1.;
          mem[34] = imgin._spectrum - 1.;
        } else mem[31] = mem[32] = mem[33] = mem[34] = 0;
        eval(code_end_t,code_end_t.end());
      }


      void end() {
        if (!code_end) return;
        if (imgin) {
          mem[31] = imgin._width - 1.;
          mem[32] = imgin._height - 1.;
          mem[33] = imgin._depth - 1.;
          mem[34] = imgin._spectrum - 1.;
        } else mem[31] = mem[32] = mem[33] = mem[34] = 0;
        eval(code_end,code_end.end());
      }



      void merge(_cimg_math_parser& mp) {
        if (&mp==this) return;
        for (int k = (int)((mp.memmerge)._height) - 1; k>=0; --k) {
          const unsigned int
            pos = (unsigned int)mp.memmerge(0,k),
            siz = (unsigned int)mp.memmerge(1,k),
            iop = (unsigned int)mp.memmerge(2,k);
          if (!siz) switch (iop) {
            case 0 : mp.mem[pos] = mem[pos]; break;
            case 1 : mp.mem[pos]+=mem[pos]; break;
            case 2 : mp.mem[pos]-=mem[pos]; break;
            case 3 : mp.mem[pos]*=mem[pos]; break;
            case 4 : mp.mem[pos]/=mem[pos]; break;
            case 5 : mp.mem[pos] = (double)((longT)mp.mem[pos] & (longT)mem[pos]); break;
            case 6 : mp.mem[pos] = (double)((longT)mp.mem[pos] | (longT)mem[pos]); break;
            case 7 : mp.mem[pos] = (double)((longT)mp.mem[pos] ^ (longT)mem[pos]); break;
            case 8 : mp.mem[pos] = mp.mem[pos] && mem[pos]; break;
            case 9 : mp.mem[pos] = mp.mem[pos] || mem[pos]; break;
            case 10 : mp.mem[pos] = std::min(mp.mem[pos],mem[pos]); break;
            case 11 : mp.mem[pos] = std::max(mp.mem[pos],mem[pos]); break;
            } else switch (iop) {
            case 0 :
              CImg<doubleT>(&mp.mem[pos + 1],siz,1,1,1,true) = CImg<doubleT>(&mem[pos + 1],siz,1,1,1,true);
              break;
            case 1 :
              CImg<doubleT>(&mp.mem[pos + 1],siz,1,1,1,true)+=CImg<doubleT>(&mem[pos + 1],siz,1,1,1,true);
              break;
            case 2 :
              CImg<doubleT>(&mp.mem[pos + 1],siz,1,1,1,true)-=CImg<doubleT>(&mem[pos + 1],siz,1,1,1,true);
              break;
            case 3 :
              CImg<doubleT>(&mp.mem[pos + 1],siz,1,1,1,true).mul(CImg<doubleT>(&mem[pos + 1],siz,1,1,1,true));
              break;
            case 4 :
              CImg<doubleT>(&mp.mem[pos + 1],siz,1,1,1,true).div(CImg<doubleT>(&mem[pos + 1],siz,1,1,1,true));
              break;
            case 5 :
              CImg<doubleT>(&mp.mem[pos + 1],siz,1,1,1,true)&=CImg<doubleT>(&mem[pos + 1],siz,1,1,1,true);
              break;
            case 6 :
              CImg<doubleT>(&mp.mem[pos + 1],siz,1,1,1,true)|=CImg<doubleT>(&mem[pos + 1],siz,1,1,1,true);
              break;
            case 7 :
              CImg<doubleT>(&mp.mem[pos + 1],siz,1,1,1,true)^=CImg<doubleT>(&mem[pos + 1],siz,1,1,1,true);
              break;
            case 8 : {
              CImg<doubleT>
                arg1(&mp.mem[pos + 1],siz,1,1,1,true),
                arg2(&mem[pos + 1],siz,1,1,1,true);
              for (unsigned long off = 0, _maxoff = (arg1).size(); off<_maxoff; ++off) arg1[off] = arg1[off] && arg2[off];
            } break;
            case 9 : {
              CImg<doubleT>
                arg1(&mp.mem[pos + 1],siz,1,1,1,true),
                arg2(&mem[pos + 1],siz,1,1,1,true);
              for (unsigned long off = 0, _maxoff = (arg1).size(); off<_maxoff; ++off) arg1[off] = arg1[off] || arg2[off];
            } break;
            case 10 :
              CImg<doubleT>(&mp.mem[pos + 1],siz,1,1,1,true).min(CImg<doubleT>(&mem[pos + 1],siz,1,1,1,true));
              break;
            case 11 :
              CImg<doubleT>(&mp.mem[pos + 1],siz,1,1,1,true).max(CImg<doubleT>(&mem[pos + 1],siz,1,1,1,true));
              break;
            }
        }
      }


