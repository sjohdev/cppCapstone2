template <typename T>
class GlobalStateManager {
 public:
  static GlobalStateManager& singleton() {
                        static GlobalStateManager singleton_;
    return singleton_;
  }

  static void push(std::shared_ptr<T>&& state) {
    auto& self = singleton();
    std::lock_guard<std::mutex> guard(self.mutex_);
    if (self.state_) {
      if (::c10::GLOG_WARNING >= (-0x7fffffff - 1)) ::c10::MessageLogger(::c10::SourceLocation::current(), ::c10::GLOG_WARNING) .stream() << "GlobalStatePtr already exists!";
    } else {
      self.state_ = std::move(state);
    }
  }

  static std::shared_ptr<T> get() {
    auto& self = singleton();
    std::lock_guard<std::mutex> guard(self.mutex_);
    return self.state_;
  }

  static std::shared_ptr<T> pop() {
    auto& self = singleton();
    std::lock_guard<std::mutex> guard(self.mutex_);
    return std::move(self.state_);
  }

 private:
  GlobalStateManager() = default;




  std::mutex mutex_;
  std::shared_ptr<T> state_;
};

