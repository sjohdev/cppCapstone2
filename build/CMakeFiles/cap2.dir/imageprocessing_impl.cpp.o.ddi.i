      static double mp_image_resize(_cimg_math_parser& mp) {
        mp_check_list(mp,"resize");
        const unsigned int ind = (unsigned int)cimg::mod((int)mp.mem[mp.opcode[2]],mp.imglist.width());
        cimg::mutex(6);
        CImg<T> &img = mp.imglist[ind];
        const double
          _w = mp.opcode[3]==~0U?-100:mp.mem[mp.opcode[3]],
          _h = mp.opcode[4]==~0U?-100:mp.mem[mp.opcode[4]],
          _d = mp.opcode[5]==~0U?-100:mp.mem[mp.opcode[5]],
          _s = mp.opcode[6]==~0U?-100:mp.mem[mp.opcode[6]];
        if (!cimg::type<double>::is_finite(_w) ||
            !cimg::type<double>::is_finite(_h) ||
            !cimg::type<double>::is_finite(_d) ||
            !cimg::type<double>::is_finite(_s)) {
          cimg::mutex(6,0);
          throw CImgArgumentException("[" "CImg" "_math_parser] CImg<%s>: Function 'resize()': "
                                      "Invalid dimensions (%g,%g,%g,%g) specified to resize image (%u,%u,%u,%u).",
                                      img.pixel_type(),_w,_h,_d,_s,img._width,img._height,img._depth,img._spectrum);
        }
        const unsigned int
          w = (unsigned int)(_w>=0?_w:-_w*img.width()/100),
          h = (unsigned int)(_h>=0?_h:-_h*img.height()/100),
          d = (unsigned int)(_d>=0?_d:-_d*img.depth()/100),
          s = (unsigned int)(_s>=0?_s:-_s*img.spectrum()/100),
          interp = (int)mp.mem[mp.opcode[7]];
        if (mp.is_fill && img._data==mp.imgout._data) {
          cimg::mutex(6,0);
          throw CImgArgumentException("[" "CImg" "_math_parser] CImg<%s>: Function 'resize()': "
                                      "Cannot both fill/eval and resize image (%u,%u,%u,%u) "
                                      "to new dimensions (%u,%u,%u,%u).",
                                      img.pixel_type(),img._width,img._height,img._depth,img._spectrum,w,h,d,s);
        }
        const unsigned int
          boundary = (int)mp.mem[mp.opcode[8]];
        const float
          cx = (float)mp.mem[mp.opcode[9]],
          cy = (float)mp.mem[mp.opcode[10]],
          cz = (float)mp.mem[mp.opcode[11]],
          cc = (float)mp.mem[mp.opcode[12]];
        img.resize(w,h,d,s,interp,boundary,cx,cy,cz,cc);
        cimg::mutex(6,0);
        return cimg::type<double>::nan();
      }

