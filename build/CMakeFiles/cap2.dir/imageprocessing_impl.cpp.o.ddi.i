      static double mp_image_draw(_cimg_math_parser& mp) {
        const int x = (int)mp.mem[mp.opcode[4]], y = (int)mp.mem[mp.opcode[5]], z = (int)mp.mem[mp.opcode[6]], c = (int)mp.mem[mp.opcode[7]];
        unsigned int ind = (unsigned int)mp.opcode[3];
        if (ind!=~0U) {
          if (!mp.imglist.width()) return cimg::type<double>::nan();
          ind = (unsigned int)cimg::mod((int)mp.mem[mp.opcode[3]],mp.imglist.width());
        }
        CImg<T> &img = ind==~0U?mp.imgout:mp.imglist[ind];
        unsigned int
          dx = (unsigned int)mp.opcode[8],
          dy = (unsigned int)mp.opcode[9],
          dz = (unsigned int)mp.opcode[10],
          dc = (unsigned int)mp.opcode[11];
        dx = dx==~0U?img._width:(unsigned int)mp.mem[mp.opcode[8]];
        dy = dy==~0U?img._height:(unsigned int)mp.mem[mp.opcode[9]];
        dz = dz==~0U?img._depth:(unsigned int)mp.mem[mp.opcode[10]];
        dc = dc==~0U?img._spectrum:(unsigned int)mp.mem[mp.opcode[11]];

        const ulongT sizS = mp.opcode[2];
        if (sizS<(ulongT)dx*dy*dz*dc)
          throw CImgArgumentException("[" "CImg" "_math_parser] CImg<%s>: Function 'draw()': "
                                      "Sprite vector (%lu values) and its specified geometry (%u,%u,%u,%u) "
                                      "(%lu values) do not match.",
                                      mp.imgin.pixel_type(),sizS,dx,dy,dz,dc,(ulongT)dx*dy*dz*dc);
        const CImg<doubleT> S(&mp.mem[mp.opcode[1]] + 1,dx,dy,dz,dc,true);
        const float opacity = (float)mp.mem[mp.opcode[12]];

        if (img._data) {
          if (mp.opcode[13]!=~0U) {
            const ulongT sizM = mp.opcode[14];
            if (sizM<(ulongT)dx*dy*dz)
              throw CImgArgumentException("[" "CImg" "_math_parser] CImg<%s>: Function 'draw()': "
                                          "Mask vector (%lu values) and specified sprite geometry (%u,%u,%u,%u) "
                                          "(%lu values) do not match.",
                                          mp.imgin.pixel_type(),sizS,dx,dy,dz,dc,(ulongT)dx*dy*dz*dc);
            const CImg<doubleT> M(&mp.mem[mp.opcode[13]] + 1,dx,dy,dz,(unsigned int)(sizM/(dx*dy*dz)),true);
            img.draw_image(x,y,z,c,S,M,opacity,(float)mp.mem[mp.opcode[15]]);
          } else img.draw_image(x,y,z,c,S,opacity);
        }
        return cimg::type<double>::nan();
      }

      static double mp_image_find(_cimg_math_parser& mp) {
        const unsigned int max_iterations = mp.opcode[6]==~0U?~0U:(unsigned int)std::max(0.,mp.mem[mp.opcode[6]]);
        if (!max_iterations) return -1;
        const unsigned int indi = (unsigned int)cimg::mod((int)mp.mem[mp.opcode[2]],mp.imglist.width());
        const CImg<T> &img = mp.imglist[indi];
        const int _step = (int)mp.mem[mp.opcode[5]], step = _step?_step:-1;
        const ulongT siz = (ulongT)img.size();
        longT ind = (longT)(mp.opcode[4]!=30?mp.mem[mp.opcode[4]]:step>0?0:siz - 1);
        if (ind<0 || ind>=(longT)siz) return -1.;
        const T
          *const ptrb = img.data(),
          *const ptre = img.end(),
          *ptr = ptrb + ind;
        const double val = mp.mem[mp.opcode[3]];


        if (step>0) {
          const T *const nptre = max_iterations==~0U?ptre:std::min(ptre,ptr + step*max_iterations);
          if (cimg::type<double>::is_nan(val))
            while (ptr<nptre && !cimg::type<double>::is_nan(*ptr)) ptr+=step;
          else
            while (ptr<nptre && (double)*ptr!=val) ptr+=step;
          return ptr>=nptre?-1.:(double)(ptr - ptrb);
        }


        const T *const nptrb = max_iterations==~0U?ptrb:std::max(ptrb,ptr + step*((longT)max_iterations - 1));
        if (cimg::type<double>::is_nan(val))
          while (ptr>=nptrb && !cimg::type<double>::is_nan(*ptr)) ptr+=step;
        else
          while (ptr>=nptrb && (double)*ptr!=val) ptr+=step;
        return ptr<nptrb?-1.:(double)(ptr - ptrb);
      }

      static double mp_image_find_seq(_cimg_math_parser& mp) {
        const unsigned int max_iterations = mp.opcode[7]==~0U?~0U:(unsigned int)std::max(0.,mp.mem[mp.opcode[7]]);
        if (!max_iterations) return -1;
        const unsigned int indi = (unsigned int)cimg::mod((int)mp.mem[mp.opcode[2]],mp.imglist.width());
        const CImg<T> &img = mp.imglist[indi];
        const int _step = (int)mp.mem[mp.opcode[6]], step = _step?_step:-1;
        const ulongT
          siz1 = (ulongT)img.size(),
          siz2 = (ulongT)mp.opcode[4];
        longT ind = (longT)(mp.opcode[5]!=30?mp.mem[mp.opcode[5]]:step>0?0:siz1 - 1);
        if (ind<0 || ind>=(longT)siz1) return -1.;
        const T
          *const ptr1b = img.data(),
          *const ptr1e = ptr1b + siz1,
          *ptr1 = ptr1b + ind,
          *p1 = 0;
        const double
          *const ptr2b = &mp.mem[mp.opcode[3]] + 1,
          *const ptr2e = ptr2b + siz2,
          *p2 = 0;


        if (step>0) {
          const T *const nptr1e = max_iterations==~0U?ptr1e:std::min(ptr1e,ptr1 + step*max_iterations);
          do {
            if (cimg::type<double>::is_nan(*ptr2b))
              while (ptr1<nptr1e && !cimg::type<double>::is_nan(*ptr1)) ptr1+=step;
            else
              while (ptr1<nptr1e && *ptr1!=*ptr2b) ptr1+=step;
            if (ptr1>=nptr1e) return -1.;
            p1 = ptr1 + 1;
            p2 = ptr2b + 1;
            while (p1<ptr1e && p2<ptr2e &&
                   ((cimg::type<double>::is_nan(*p1) && cimg::type<double>::is_nan(*p2)) || *p1==*p2)) { ++p1; ++p2; }
          } while (p2<ptr2e && (ptr1+=step)<ptr1e);
          return p2<ptr2e?-1.:(double)(ptr1 - ptr1b);
        }


        const T *const nptr1b = max_iterations==~0U?ptr1b:std::max(ptr1b,ptr1 + step*((longT)max_iterations - 1));
        do {
          if (cimg::type<double>::is_nan(*ptr2b))
            while (ptr1>=nptr1b && !cimg::type<double>::is_nan(*ptr1)) ptr1+=step;
          else
            while (ptr1>=nptr1b && *ptr1!=*ptr2b) ptr1+=step;
          if (ptr1<nptr1b) return -1.;
          p1 = ptr1 + 1;
          p2 = ptr2b + 1;
          while (p1<ptr1e && p2<ptr2e &&
                 ((cimg::type<double>::is_nan(*p1) && cimg::type<double>::is_nan(*p2)) || *p1==*p2)) { ++p1; ++p2; }
        } while (p2<ptr2e && (ptr1+=step)>=ptr1b);
        return p2<ptr2e?-1.:(double)(ptr1 - ptr1b);
      }

