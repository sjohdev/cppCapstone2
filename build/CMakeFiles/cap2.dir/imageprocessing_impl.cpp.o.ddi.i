              std::memcpy(data(0,0,0,c),buf,-ndelta_z*_width*_height*sizeof(T));
            }
        } break;
        case 1 :
          if (delta_z<0) {
            const int ndelta_z = (-delta_z>=depth())?depth() - 1:-delta_z;
            if (!ndelta_z) return *this;
            for (int c = 0; c<(int)((*this)._spectrum); ++c) {
              std::memmove(data(0,0,0,c),data(0,0,ndelta_z,c),_width*_height*(_depth-ndelta_z)*sizeof(T));
              T *ptrd = data(0,0,_depth-ndelta_z,c), *ptrs = data(0,0,_depth - 1,c);
              for (int l = 0; l<ndelta_z - 1; ++l) {
                std::memcpy(ptrd,ptrs,_width*_height*sizeof(T)); ptrd+=(ulongT)_width*_height;
              }
            }
          } else {
            const int ndelta_z = (delta_z>=depth())?depth() - 1:delta_z;
            if (!ndelta_z) return *this;
            for (int c = 0; c<(int)((*this)._spectrum); ++c) {
              std::memmove(data(0,0,ndelta_z,c),data(0,0,0,c),_width*_height*(_depth-ndelta_z)*sizeof(T));
              T *ptrd = data(0,0,1,c), *ptrs = data(0,0,0,c);
              for (int l = 0; l<ndelta_z - 1; ++l) {
                std::memcpy(ptrd,ptrs,_width*_height*sizeof(T)); ptrd+=(ulongT)_width*_height;
              }
            }
          }
          break;
        default :
          if (delta_z<=-depth() || delta_z>=depth()) return fill((T)0);
          if (delta_z<0) for (int c = 0; c<(int)((*this)._spectrum); ++c) {
              std::memmove(data(0,0,0,c),data(0,0,-delta_z,c),_width*_height*(_depth + delta_z)*sizeof(T));
              std::memset(data(0,0,_depth + delta_z,c),0,_width*_height*(-delta_z)*sizeof(T));
            } else for (int c = 0; c<(int)((*this)._spectrum); ++c) {
              std::memmove(data(0,0,delta_z,c),data(0,0,0,c),_width*_height*(_depth-delta_z)*sizeof(T));
              std::memset(data(0,0,0,c),0,delta_z*_width*_height*sizeof(T));
            }
        }

      if (delta_c)
        switch (boundary_conditions) {
        case 2 : {
          const int ml = cimg::mod(-delta_c,spectrum()), ndelta_c = (ml<=spectrum()/2)?ml:(ml-spectrum());
          if (!ndelta_c) return *this;
          CImg<T> buf(width(),height(),depth(),cimg::abs(ndelta_c));
          if (ndelta_c>0) {
            std::memcpy(buf,_data,_width*_height*_depth*ndelta_c*sizeof(T));
            std::memmove(_data,data(0,0,0,ndelta_c),_width*_height*_depth*(_spectrum-ndelta_c)*sizeof(T));
            std::memcpy(data(0,0,0,_spectrum-ndelta_c),buf,_width*_height*_depth*ndelta_c*sizeof(T));
          } else {
            std::memcpy(buf,data(0,0,0,_spectrum + ndelta_c),-ndelta_c*_width*_height*_depth*sizeof(T));
            std::memmove(data(0,0,0,-ndelta_c),_data,_width*_height*_depth*(_spectrum + ndelta_c)*sizeof(T));
            std::memcpy(_data,buf,-ndelta_c*_width*_height*_depth*sizeof(T));
          }
        } break;
        case 1 :
          if (delta_c<0) {
            const int ndelta_c = (-delta_c>=spectrum())?spectrum() - 1:-delta_c;
            if (!ndelta_c) return *this;
            std::memmove(_data,data(0,0,0,ndelta_c),_width*_height*_depth*(_spectrum-ndelta_c)*sizeof(T));
            T *ptrd = data(0,0,0,_spectrum-ndelta_c), *ptrs = data(0,0,0,_spectrum - 1);
            for (int l = 0; l<ndelta_c - 1; ++l) {
              std::memcpy(ptrd,ptrs,_width*_height*_depth*sizeof(T)); ptrd+=(ulongT)_width*_height*_depth;
            }
          } else {
            const int ndelta_c = (delta_c>=spectrum())?spectrum() - 1:delta_c;
            if (!ndelta_c) return *this;
            std::memmove(data(0,0,0,ndelta_c),_data,_width*_height*_depth*(_spectrum-ndelta_c)*sizeof(T));
            T *ptrd = data(0,0,0,1);
            for (int l = 0; l<ndelta_c - 1; ++l) {
              std::memcpy(ptrd,_data,_width*_height*_depth*sizeof(T)); ptrd+=(ulongT)_width*_height*_depth;
            }
          }
          break;
        default :
          if (delta_c<=-spectrum() || delta_c>=spectrum()) return fill((T)0);
          if (delta_c<0) {
            std::memmove(_data,data(0,0,0,-delta_c),_width*_height*_depth*(_spectrum + delta_c)*sizeof(T));
            std::memset(data(0,0,0,_spectrum + delta_c),0,_width*_height*_depth*(-delta_c)*sizeof(T));
          } else {
            std::memmove(data(0,0,0,delta_c),_data,_width*_height*_depth*(_spectrum-delta_c)*sizeof(T));
            std::memset(_data,0,delta_c*_width*_height*_depth*sizeof(T));
          }
        }
      return *this;
    }


    CImg<T> get_shift(const int delta_x, const int delta_y=0, const int delta_z=0, const int delta_c=0,
                      const unsigned int boundary_conditions=0) const {
      return (+*this).shift(delta_x,delta_y,delta_z,delta_c,boundary_conditions);
    }






    CImg<T>& permute_axes(const char *const axes_order) {
      if (is_empty() || !axes_order) return *this;
      const unsigned uicase = _permute_axes_uicase(axes_order);
      if (_permute_axes_is_optim(uicase)) {
        CImg<T> res(*this,true);
        for (unsigned int i = 0; i<4; ++i) {
          const unsigned int
            axis = (uicase>>(4*(3 - i)))&15,
            value = !axis?_width:axis==1?_height:axis==2?_depth:_spectrum;
          if (!i) res._width = value; else if (i==1) res._height = value;
          else if (i==2) res._depth = value; else res._spectrum = value;
        }
        _width = res._width; _height = res._height; _depth = res._depth; _spectrum = res._spectrum;
        return *this;
      }
      if (_permute_axes_inplace(uicase)) return *this;
      return get_permute_axes(axes_order).move_to(*this);
    }


    static void _permute_axes_cpy(T *const dst, const T *const src, const unsigned long E) {
      if (E==1) *dst = *src; else std::memcpy(dst,src,(size_t)E*sizeof(T));
    }




    static void _permute_axes_cycles(T *const ptr, const unsigned long rows, const unsigned long cols,
                                     const unsigned long S, const unsigned long Lmax,
                                     T *const tmp, unsigned char *const done) {
      if (rows<2 || cols<2) return;
      const unsigned long M = rows*cols - 1;
      for (unsigned long i0 = 0; i0<S; i0+=Lmax) {
        const unsigned long L = S - i0<Lmax?S - i0:Lmax;
        const size_t nbytes = (size_t)L*sizeof(T);
        T *const p = ptr + i0;
        std::memset(done,0,(size_t)(M/8 + 1));
        for (unsigned long s = 1; s<M; ++s) {
          if (done[s>>3]&(1U<<(s&7))) continue;
          std::memcpy(tmp,p + s*S,nbytes);
          unsigned long d = s;
          for (;;) {
            done[d>>3]|=(unsigned char)(1U<<(d&7));
            const unsigned long src = (d*cols)%M;
            if (src==s) { std::memcpy(p + d*S,tmp,nbytes); break; }
            std::memcpy(p + d*S,p + src*S,nbytes);
            d = src;
          }
        }
      }
    }



    static void _permute_axes_transpose(T *const ptr, const unsigned long rows, const unsigned long cols,
                                        const unsigned long E, const unsigned long outer) {
      if (rows<2 || cols<2 || !E || !outer) return;
      const unsigned long slice = rows*cols*E, sz = (unsigned long)sizeof(T);
      if (rows==cols) {
        for (unsigned long o = 0; o<outer; ++o) {
          T *const p = ptr + o*slice;
          for (unsigned long r = 0; r<rows; ++r) for (unsigned long c = r + 1; c<cols; ++c) {
              T *const a = p + (r*cols + c)*E, *const b = p + (c*rows + r)*E;
              for (unsigned long i = 0; i<E; ++i) cimg::swap(a[i],b[i]);
            }
        }
        return;
      }


      const bool is_fwd = rows<cols;
      const unsigned long
        R = is_fwd?rows:cols, K = is_fwd?cols:rows,
        B0 = R*E*sz<=32768?32768/(R*E*sz):1,
        B = K<B0?K:B0, m = K/B, rem = K%B, mB = m*B, S = B*E,
        Lel = 32768/sz?32768/sz:1,
        Lmax = S<Lel?S:Lel,
        tsz = B>1?R*S:Lmax;
      T *const tmp = new T[(size_t)tsz];
      unsigned char *const done = new unsigned char[(size_t)((R*m)/8 + 1)];

      for (unsigned long o = 0; o<outer; ++o) {
        T *const p = ptr + o*slice;
        if (is_fwd) {
          if (rem) {
            for (unsigned long r = 0; r<R; ++r) std::memcpy(tmp + r*rem*E,p + (r*K + mB)*E,(size_t)(rem*E*sz));
            for (unsigned long r = 1; r<R; ++r) std::memmove(p + r*mB*E,p + r*K*E,(size_t)(mB*E*sz));
            T *const out = p + R*mB*E;
            for (unsigned long b = 0; b<rem; ++b) for (unsigned long r = 0; r<R; ++r)
                                                  _permute_axes_cpy(out + (b*R + r)*E,tmp + (r*rem + b)*E,E);
          }
          _permute_axes_cycles(p,R,m,S,Lmax,tmp,done);
          if (B>1) for (unsigned long j = 0; j<m; ++j) {
              T *const blk = p + j*R*S;
              std::memcpy(tmp,blk,(size_t)(R*S*sz));
              for (unsigned long b = 0; b<B; ++b) for (unsigned long r = 0; r<R; ++r)
                                                  _permute_axes_cpy(blk + (b*R + r)*E,tmp + (r*B + b)*E,E);
            }
        } else {
          if (B>1) for (unsigned long j = 0; j<m; ++j) {
              T *const blk = p + j*R*S;
              std::memcpy(tmp,blk,(size_t)(R*S*sz));
              for (unsigned long r = 0; r<R; ++r) for (unsigned long b = 0; b<B; ++b)
                                                  _permute_axes_cpy(blk + (r*B + b)*E,tmp + (b*R + r)*E,E);
            }
          if (rem) {
            T *const tail = p + R*mB*E;
            std::memcpy(tmp,tail,(size_t)(R*rem*E*sz));
            for (unsigned long r = 0; r<R; ++r) for (unsigned long b = 0; b<rem; ++b)
                                                _permute_axes_cpy(tail + (r*rem + b)*E,tmp + (b*R + r)*E,E);
          }
          _permute_axes_cycles(p,m,R,S,Lmax,tmp,done);
          if (rem) {
            std::memcpy(tmp,p + R*mB*E,(size_t)(R*rem*E*sz));
            for (unsigned long r = R - 1; r>=1; --r) std::memmove(p + r*K*E,p + r*mB*E,(size_t)(mB*E*sz));
            for (unsigned long r = 0; r<R; ++r) std::memcpy(p + (r*K + mB)*E,tmp + r*rem*E,(size_t)(rem*E*sz));
          }
        }
      }
      delete[] tmp; delete[] done;
    }



    bool _permute_axes_inplace(const unsigned int uicase) {
      unsigned int tgt[4], cur[4] = { 0,1,2,3 };
      bool used[4] = { false,false,false,false };
      for (unsigned int i = 0; i<4; ++i) {
        tgt[i] = (uicase>>(4*(3 - i)))&15;
        if (tgt[i]>3 || used[tgt[i]]) return false;
        used[tgt[i]] = true;
      }
      unsigned long dim[4] = { _width,_height,_depth,_spectrum };
      for (unsigned int p = 0; p<3; ++p) {
        unsigned int q = p;
        while (cur[q]!=tgt[p]) ++q;
        if (q==p) continue;
        unsigned long A = 1, E = 1, O = 1;
        for (unsigned int t = p; t<q; ++t) A*=dim[t];
        for (unsigned int t = 0; t<p; ++t) E*=dim[t];
        for (unsigned int t = q + 1; t<4; ++t) O*=dim[t];
        _permute_axes_transpose(_data,dim[q],A,E,O);
        const unsigned int c = cur[q]; const unsigned long dq = dim[q];
        for (unsigned int t = q; t>p; --t) { cur[t] = cur[t - 1]; dim[t] = dim[t - 1]; }
        cur[p] = c; dim[p] = dq;
      }
      _width = (unsigned int)dim[0]; _height = (unsigned int)dim[1];
      _depth = (unsigned int)dim[2]; _spectrum = (unsigned int)dim[3];
      return true;
    }


    CImg<T> get_permute_axes(const char *const axes_order) const {
      const T foo = (T)0;
      return _permute_axes(axes_order,foo);
    }

    unsigned int _permute_axes_uicase(const char *const axes_order) const {
      unsigned char s_axes[4] = { 0,1,2,3 }, n_axes[4] = { };
      bool is_error = false;
      if (axes_order) for (unsigned int l = 0; axes_order[l]; ++l) {
          int c = cimg::lowercase(axes_order[l]);
          if (l>=4 || (c!='x' && c!='y' && c!='z' && c!='c')) { is_error = true; break; }
          else { ++n_axes[c%=4]; s_axes[l] = (unsigned char)c; }
        }
      is_error|=(*n_axes>1) || (n_axes[1]>1) || (n_axes[2]>1) || (n_axes[3]>1);
      if (is_error)
        throw CImgArgumentException("[instance(%u,%u,%u,%u,%p,%sshared)] CImg<%s>::"
                                    "permute_axes(): Invalid specified axes order '%s'.",
                                    _width,_height,_depth,_spectrum,_data,_is_shared?"":"non-",pixel_type(),
                                    axes_order);
      return (s_axes[0]<<12) | (s_axes[1]<<8) | (s_axes[2]<<4) | (s_axes[3]);
    }

    bool _permute_axes_is_optim(const unsigned int uicase) const {
      const unsigned int co = ((_width>1)<<3)|((_height>1)<<2)|((_depth>1)<<1)|(_spectrum>1);
      if (co<=2 || uicase==0x0123) return true;
      switch (uicase) {
      case (0x0132) : if ((co>=4 && co<=6) || (co>=8 && co<=10) || (co>=12 && co<=14)) return true; break;
      case (0x0213) : if ((co>=3 && co<=5) || (co>=8 && co<=13)) return true; break;
      case (0x0231) : if (co==3 || co==4 || (co>=8 && co<=12)) return true; break;
      case (0x0312) : if (co==4 || co==6 || co==8 || co==9 || co==10 || co==12 || co==14) return true; break;
      case (0x0321) : if (co==4 || (co>=8 && co<=10) || co==12) return true; break;
      case (0x1023) : if (co>=3 && co<=11) return true; break;
      case (0x1032) : if ((co>=4 && co<=6) || (co>=8 && co<=10)) return true; break;
      case (0x1203) : if (co>=3 && co<=9) return true; break;
      case (0x1230) : if (co>=3 && co<=8) return true; break;
      case (0x1302) : if ((co>=4 && co<=6) || co==8 || co==10) return true; break;
      case (0x1320) : if ((co>=4 && co<=6) || co==8) return true; break;
      case (0x2013) : if ((co>=3 && co<=5) || co==8 || co==9 || co==12 || co==13) return true; break;
      case (0x2031) : if (co==3 || co==4 || co==8 || co==9 || co==12) return true; break;
      case (0x2103) : if ((co>=3 && co<=5) || co==8 || co==9) return true; break;
      case (0x2130) : if ((co>=3 && co<=5) || co==8) return true; break;
      case (0x2301) : if (co==3 || co==4 || co==8 || co==12) return true; break;
      case (0x2310) : if (co==3 || co==4 || co==8) return true; break;
      case (0x3012) : if (co==4 || co==6 || co==8 || co==10 || co==12 || co==14) return true; break;
      case (0x3021) : if (co==4 || co==8 || co==10 || co==12) return true; break;
      case (0x3102) : if (co==4 || co==6 || co==8 || co==10) return true; break;
      case (0x3120) : if (co==4 || co==6 || co==8) return true; break;
      case (0x3201) : if (co==4 || co==8 || co==12) return true; break;
      case (0x3210) : if (co==4 || co==8) return true; break;
      }
      return false;
    }

    template<typename t>
    CImg<t> _permute_axes(const char *const axes_order, const t&) const {
      if (is_empty() || !axes_order) return CImg<t>(*this,false);
      CImg<t> res;
      const unsigned uicase = _permute_axes_uicase(axes_order);

      if (_permute_axes_is_optim(uicase)) {
        res.assign(*this,false);
        for (unsigned int i = 0; i<4; ++i) {
          const unsigned int
            axis = (uicase>>(4*(3 - i)))&15,
            value = !axis?_width:axis==1?_height:axis==2?_depth:_spectrum;
          if (!i) res._width = value; else if (i==1) res._height = value;
          else if (i==2) res._depth = value; else res._spectrum = value;
        }
        return res;
      }

      const T* ptrs = _data;
      ulongT wh, whd;

      switch (uicase) {
      case 0x0123 :
        return +*this;
      case 0x0132 :
        res.assign(_width,_height,_spectrum,_depth);
        wh = (ulongT)res._width*res._height; whd = wh*res._depth;
        for (int c = 0; c<(int)((*this)._spectrum); ++c) for (int z = 0; z<(int)((*this)._depth); ++z) for (int y = 0; y<(int)((*this)._height); ++y) for (int x = 0; x<(int)((*this)._width); ++x) res(x,y,c,z,wh,whd) = (t)*(ptrs++);
        break;
      case 0x0213 :
        res.assign(_width,_depth,_height,_spectrum);
        wh = (ulongT)res._width*res._height; whd = wh*res._depth;
        for (int c = 0; c<(int)((*this)._spectrum); ++c) for (int z = 0; z<(int)((*this)._depth); ++z) for (int y = 0; y<(int)((*this)._height); ++y) for (int x = 0; x<(int)((*this)._width); ++x) res(x,z,y,c,wh,whd) = (t)*(ptrs++);
        break;
      case 0x0231 :
        res.assign(_width,_depth,_spectrum,_height);
        wh = (ulongT)res._width*res._height; whd = wh*res._depth;
        for (int c = 0; c<(int)((*this)._spectrum); ++c) for (int z = 0; z<(int)((*this)._depth); ++z) for (int y = 0; y<(int)((*this)._height); ++y) for (int x = 0; x<(int)((*this)._width); ++x) res(x,z,c,y,wh,whd) = (t)*(ptrs++);
        break;
      case 0x0312 :
        res.assign(_width,_spectrum,_height,_depth);
        wh = (ulongT)res._width*res._height; whd = wh*res._depth;
        for (int c = 0; c<(int)((*this)._spectrum); ++c) for (int z = 0; z<(int)((*this)._depth); ++z) for (int y = 0; y<(int)((*this)._height); ++y) for (int x = 0; x<(int)((*this)._width); ++x) res(x,c,y,z,wh,whd) = (t)*(ptrs++);
        break;
      case 0x0321 :
        res.assign(_width,_spectrum,_depth,_height);
        wh = (ulongT)res._width*res._height; whd = wh*res._depth;
        for (int c = 0; c<(int)((*this)._spectrum); ++c) for (int z = 0; z<(int)((*this)._depth); ++z) for (int y = 0; y<(int)((*this)._height); ++y) for (int x = 0; x<(int)((*this)._width); ++x) res(x,c,z,y,wh,whd) = (t)*(ptrs++);
        break;
      case 0x1023 :
        res.assign(_height,_width,_depth,_spectrum);
        wh = (ulongT)res._width*res._height; whd = wh*res._depth;
        for (int c = 0; c<(int)((*this)._spectrum); ++c) for (int z = 0; z<(int)((*this)._depth); ++z) for (int y = 0; y<(int)((*this)._height); ++y) for (int x = 0; x<(int)((*this)._width); ++x) res(y,x,z,c,wh,whd) = (t)*(ptrs++);
        break;
      case 0x1032 :
        res.assign(_height,_width,_spectrum,_depth);
        wh = (ulongT)res._width*res._height; whd = wh*res._depth;
        for (int c = 0; c<(int)((*this)._spectrum); ++c) for (int z = 0; z<(int)((*this)._depth); ++z) for (int y = 0; y<(int)((*this)._height); ++y) for (int x = 0; x<(int)((*this)._width); ++x) res(y,x,c,z,wh,whd) = (t)*(ptrs++);
        break;
      case 0x1203 :
        res.assign(_height,_depth,_width,_spectrum);
        wh = (ulongT)res._width*res._height; whd = wh*res._depth;
        for (int c = 0; c<(int)((*this)._spectrum); ++c) for (int z = 0; z<(int)((*this)._depth); ++z) for (int y = 0; y<(int)((*this)._height); ++y) for (int x = 0; x<(int)((*this)._width); ++x) res(y,z,x,c,wh,whd) = (t)*(ptrs++);
        break;
      case 0x1230 :
        res.assign(_height,_depth,_spectrum,_width);
        switch (_width) {
        case 1 : {
          t *ptr_r = res.data(0,0,0,0);
          for (unsigned int siz = _height*_depth*_spectrum; siz; --siz) {
            *(ptr_r++) = (t)*(ptrs++);
          }
        } break;
        case 2 : {
          t *ptr_r = res.data(0,0,0,0), *ptr_g = res.data(0,0,0,1);
          for (unsigned int siz = _height*_depth*_spectrum; siz; --siz) {
            *(ptr_r++) = (t)ptrs[0];
            *(ptr_g++) = (t)ptrs[1];
            ptrs+=2;
          }
        } break;
        case 3 : {
          t *ptr_r = res.data(0,0,0,0), *ptr_g = res.data(0,0,0,1), *ptr_b = res.data(0,0,0,2);
          for (unsigned int siz = _height*_depth*_spectrum; siz; --siz) {
            *(ptr_r++) = (t)ptrs[0];
            *(ptr_g++) = (t)ptrs[1];
            *(ptr_b++) = (t)ptrs[2];
            ptrs+=3;
          }
        } break;
        case 4 : {
          t
            *ptr_r = res.data(0,0,0,0), *ptr_g = res.data(0,0,0,1),
            *ptr_b = res.data(0,0,0,2), *ptr_a = res.data(0,0,0,3);
          for (unsigned int siz = _height*_depth*_spectrum; siz; --siz) {
            *(ptr_r++) = (t)ptrs[0];
            *(ptr_g++) = (t)ptrs[1];
            *(ptr_b++) = (t)ptrs[2];
            *(ptr_a++) = (t)ptrs[3];
            ptrs+=4;
          }
        } break;
        default : {
          wh = (ulongT)res._width*res._height; whd = wh*res._depth;
