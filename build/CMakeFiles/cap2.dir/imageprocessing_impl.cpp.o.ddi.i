      static double mp_complex_pow_vv(_cimg_math_parser& mp) {
        const double *ptr1 = &mp.mem[mp.opcode[2]] + 1, *ptr2 = &mp.mem[mp.opcode[3]] + 1;
        double *ptrd = &mp.mem[mp.opcode[1]] + 1;
        _mp_complex_pow(ptr1[0],ptr1[1],ptr2[0],ptr2[1],ptrd);
